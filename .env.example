# ==============================================================================
# WAGateway Pro Enterprise Environment Configuration
# ==============================================================================

PORT=7860
SESSION_DIR=./sessions
SESSION_ID=engine-primary
BOT_NAME=WABot Enterprise
COMMAND_PREFIX=!
AUTO_RECONNECT=true

# ==============================================================================
# Supabase Cloud Configuration (Optional: for Cloud Persistence across HF Restarts)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ==============================================================================
# Internal Node Engine Secret (for Cloudflare Worker -> HF Space communication)
# ==============================================================================
INTERNAL_ENGINE_SECRET=sec_hf_internal_live_key_99
